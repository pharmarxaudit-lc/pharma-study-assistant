# Environment variables
.env
.env.local

# Uploads and outputs - TEMPORARILY TRACKED FOR CORE CONTENT
# uploads/
# outputs/
# *.pdf

# Logs - centralized in /logs/ directory
logs/
*.log

# Database - NOT tracked in git to prevent overwriting production data
# Each environment (local, Replit) maintains its own database
# Schema changes are managed through Alembic migrations
pharma_exam.db           # Ignore root-level database file
backend/pharma_exam.db   # Ignore production database
*_backup_*.db            # Ignore backup database files
*.db-journal             # Ignore SQLite journal files

# Keep baseline database for fresh deployments
!backend/pharma_exam_baseline.db

# Keep database backups for preservation
!backend/backups/
!backend/backups/**/*.db
!backend/backups/**/*.json
!backend/backups/**/*.sql
!backend/backups/**/*.md

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Node modules (root level for any tools)
node_modules/

# Backend static (built frontend)
backend/static/

